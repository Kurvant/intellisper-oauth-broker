# ── Intellisper OAuth Broker configuration ──────────────────────────────────────────────────────
# Copy to a real secret manager (Railway secret / AWS Secrets Manager). NEVER commit real values.

# Shared secret the platform must present as `Authorization: Bearer <key>`.
# Generate: openssl rand -hex 32
BROKER_API_KEY=

# Registered OAuth providers + their CLIENT SECRETS, as JSON. The secret never leaves this service.
# One object per (blockName, clientId) pair the platform will use for cloud OAuth connections.
OAUTH_PROVIDERS=[{"blockName":"@intelblocks/block-slack","clientId":"REPLACE","clientSecret":"REPLACE"}]

# STRONGLY RECOMMENDED in production: comma-separated allowlist of provider token hosts. When set,
# the broker will only ever POST a client secret to these hosts (or their subdomains). This is the
# real SSRF defence — without it, only literal private IPs and non-HTTPS are blocked.
# Example: slack.com,oauth2.googleapis.com,login.microsoftonline.com
PROVIDER_HOST_ALLOWLIST=

# Optional tuning.
PORT=8080
LOG_LEVEL=info
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# ── Licensing (optional) ─────────────────────────────────────────────────────────────────────
# When DATABASE_URL is unset, the license routes return 503 and OAuth brokering is unaffected.
# The broker becomes the license authority (issues/stores/verifies/revokes license keys) only
# when these are configured.
DATABASE_URL=

# Ed25519 private key (PEM, PKCS8) used to sign entitlement documents. The product ships the
# matching PUBLIC key and verifies signatures, enabling offline grace + ~72h revocation.
# Generate: openssl genpkey -algorithm ed25519 -out key.pem  (then paste the PEM here)
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KEY_ID=ilk-sign-2026-01

# SEPARATE secret from BROKER_API_KEY. Gates /manage/* and /license-keys/extend-trial so the
# platform's OAuth credential can never mint or revoke licenses. Generate: openssl rand -hex 32
LICENSE_MANAGEMENT_API_KEY=

# Trial policy. Default is manual approval (a request lands in the queue for an operator).
TRIAL_AUTO_ISSUE=false
TRIAL_DAYS=14

# Tighter rate limit for the public, unauthenticated license routes.
LICENSE_RATE_LIMIT_MAX=30
LICENSE_RATE_LIMIT_WINDOW=1 minute
